# Privy Configuration
VITE_PRIVY_APP_ID=your_privy_app_id_here
VITE_PRIVY_CLIENT_ID=

# WalletConnect Project ID (optional, for better wallet support)
# Get your project ID from https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=

# Sei Network RPC (optional, defaults to public RPC)
VITE_SEI_RPC_URL=https://evm-rpc.sei-apis.com

# API Configuration (Set in Vercel Dashboard)
NEXT_PUBLIC_BACKEND_URL=
VITE_API_URL=
VITE_WS_URL=

# Orchestrator API Configuration (Set in Vercel Dashboard)
VITE_ORCHESTRATOR_API=
VITE_ORCHESTRATOR_WS=

# Optional: Override the internal orchestrator endpoints
ORCHESTRATOR_ENDPOINT=
ORCHESTRATOR_WS_ENDPOINT=

# ElevenLabs Configuration (for voice features)
# Set in Vercel Dashboard > Environment Variables:
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VITE_ELEVENLABS_VOICE_ID=your_voice_id_here
VITE_VOICE_ENABLED=true

# Voice API Security (Set in Vercel Dashboard)
# API_SECRET_KEY=your_secret_api_key_here
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Upstash Redis Configuration (Set in Vercel Dashboard)
# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Vercel KV Configuration (Automatically provided by Vercel)
# KV_REST_API_URL=https://your-kv-instance.kv.vercel-storage.com
# KV_REST_API_TOKEN=your_kv_token_here
# KV_REST_API_READ_ONLY_TOKEN=your_kv_readonly_token_here

# Voice Settings (optional)
VITE_VOICE_STABILITY=0.5
VITE_VOICE_SIMILARITY_BOOST=0.8
VITE_VOICE_STYLE=0.0
VITE_VOICE_USE_SPEAKER_BOOST=true

# AI Integration (Set in Vercel Dashboard)
# OPENAI_API_KEY=sk-your_openai_api_key_here
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# MCP (Model Context Protocol) Frontend Configuration
# ====================================================

# MCP Vercel API Routes (Always enabled for hackathon)
VITE_MCP_USE_VERCEL_PROXY=true  # Always use Vercel API routes
VITE_MCP_API_ENDPOINT=/api/mcp  # Relative path to API routes

# MCP Public API Keys (safe for frontend)
VITE_MCP_PUBLIC_API_KEY=
VITE_MCP_CLIENT_ID=

# MCP Feature Flags
VITE_MCP_ENABLE_SEI_ADAPTER=true
VITE_MCP_ENABLE_OMNISEARCH=true
VITE_MCP_ENABLE_PUPPETEER=true
VITE_MCP_ENABLE_REALTIME_SYNC=true
VITE_MCP_ENABLE_OFFLINE_MODE=false

# MCP UI Configuration
VITE_MCP_SHOW_STATUS_INDICATOR=true
VITE_MCP_SHOW_DEBUG_PANEL=false
VITE_MCP_AUTO_CONNECT=true
VITE_MCP_CONNECTION_RETRY_UI=true

# MCP Request Configuration
VITE_MCP_DEFAULT_REQUEST_TIMEOUT=60000
VITE_MCP_MAX_REQUEST_RETRIES=3
VITE_MCP_REQUEST_BATCH_SIZE=10
VITE_MCP_REQUEST_RATE_LIMIT=100

# MCP Message Queue Settings
VITE_MCP_MESSAGE_QUEUE_SIZE=1000
VITE_MCP_MESSAGE_PRIORITY_ENABLED=true
VITE_MCP_MESSAGE_COMPRESSION=true

# MCP Logging Settings (frontend)
VITE_MCP_LOG_LEVEL=warn # Options: debug, info, warn, error, none
VITE_MCP_LOG_TO_CONSOLE=true
VITE_MCP_LOG_TO_SERVER=false
VITE_MCP_LOG_PERFORMANCE=false