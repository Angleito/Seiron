# Server Configuration
PORT=8000
NODE_ENV=development
LOG_LEVEL=info

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Database
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Redis
REDIS_URL=redis://localhost:6379

# AI Configuration - Required for AI functionality
# OpenAI API (Required for GPT models)
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic API (Optional - for Claude models)
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Sei Network Configuration
SEI_NETWORK=testnet
SEI_CHAIN_ID=atlantic-2
SEI_RPC_URL=https://rpc-testnet.sei.io
SEI_EVM_RPC_URL=https://evm-rpc-testnet.sei.io

# Hive Intelligence API (Required for blockchain queries)
HIVE_INTELLIGENCE_API_KEY=your_hive_intelligence_api_key_here
HIVE_INTELLIGENCE_BASE_URL=https://api.hiveintelligence.xyz/v1
HIVE_INTELLIGENCE_RATE_LIMIT=20
HIVE_INTELLIGENCE_CACHE_TTL=300
HIVE_INTELLIGENCE_RETRY_ATTEMPTS=2
HIVE_INTELLIGENCE_RETRY_DELAY=1000

# Sei Agent Kit Adapter
SAK_ENABLED=true
# Optional: Private key for transaction signing
SAK_WALLET_PRIVATE_KEY=
# Optional: Mnemonic for wallet generation
SAK_WALLET_MNEMONIC=
SAK_RATE_LIMIT=60

# MCP (Model Context Protocol) Configuration
# ============================================

# Global MCP Settings
MCP_ENABLED=true
MCP_DEFAULT_TRANSPORT=websocket # Options: websocket, http, stdio
MCP_DEFAULT_TIMEOUT=30000
MCP_DEFAULT_RETRY_ATTEMPTS=3
MCP_DEFAULT_RETRY_DELAY=1000
MCP_HEARTBEAT_INTERVAL=30000
MCP_MAX_RECONNECT_ATTEMPTS=5

# MCP Server 1: Sei MCP Adapter (Primary)
MCP_SEI_ENABLED=true
MCP_SEI_TRANSPORT=websocket
MCP_SEI_ENDPOINT=ws://localhost:8765
MCP_SEI_HTTP_ENDPOINT=http://localhost:8765
MCP_SEI_API_KEY=
MCP_SEI_CONNECTION_TIMEOUT=30000
MCP_SEI_REQUEST_TIMEOUT=60000
MCP_SEI_MAX_MESSAGE_SIZE=1048576 # 1MB
MCP_SEI_COMPRESSION_ENABLED=true

# MCP Server 2: omnisearch (Search and Web Tools)
MCP_OMNISEARCH_ENABLED=true
MCP_OMNISEARCH_TRANSPORT=http
MCP_OMNISEARCH_ENDPOINT=http://localhost:8766
MCP_OMNISEARCH_API_KEY=
MCP_OMNISEARCH_TAVILY_API_KEY=
MCP_OMNISEARCH_BRAVE_API_KEY=
MCP_OMNISEARCH_KAGI_API_KEY=
MCP_OMNISEARCH_PERPLEXITY_API_KEY=
MCP_OMNISEARCH_JINA_API_KEY=
MCP_OMNISEARCH_FIRECRAWL_API_KEY=
MCP_OMNISEARCH_CONNECTION_TIMEOUT=30000
MCP_OMNISEARCH_REQUEST_TIMEOUT=120000

# MCP Server 3: puppeteer (Browser Automation)
MCP_PUPPETEER_ENABLED=true
MCP_PUPPETEER_TRANSPORT=stdio
MCP_PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/puppeteer-mcp
MCP_PUPPETEER_BROWSER_PATH=/usr/bin/chromium
MCP_PUPPETEER_HEADLESS=true
MCP_PUPPETEER_SANDBOX=true
MCP_PUPPETEER_VIEWPORT_WIDTH=1920
MCP_PUPPETEER_VIEWPORT_HEIGHT=1080
MCP_PUPPETEER_DEFAULT_TIMEOUT=30000
MCP_PUPPETEER_NAVIGATION_TIMEOUT=60000

# MCP Authentication & Security
MCP_AUTH_TYPE=bearer # Options: none, bearer, oauth2, custom
MCP_AUTH_HEADER_NAME=Authorization
MCP_CORS_ENABLED=true
MCP_CORS_ALLOWED_ORIGINS=http://localhost:3000,https://seiron.app
MCP_RATE_LIMIT_ENABLED=true
MCP_RATE_LIMIT_MAX_REQUESTS=100
MCP_RATE_LIMIT_WINDOW_MS=60000

# MCP Connection Pool Settings
MCP_POOL_MIN_CONNECTIONS=2
MCP_POOL_MAX_CONNECTIONS=10
MCP_POOL_IDLE_TIMEOUT=300000
MCP_POOL_ACQUIRE_TIMEOUT=10000

# MCP Logging & Monitoring
MCP_LOG_LEVEL=info # Options: debug, info, warn, error
MCP_LOG_REQUESTS=true
MCP_LOG_RESPONSES=false
MCP_METRICS_ENABLED=true
MCP_METRICS_PORT=9090
MCP_TRACE_ENABLED=false
MCP_TRACE_SAMPLE_RATE=0.1

# Protocol Configurations
TAKARA_ENABLED=true
SYMPHONY_ENABLED=true
DRAGONSWAP_ENABLED=true
SILO_ENABLED=true