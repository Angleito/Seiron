# SEI Blockchain RPC Endpoints
SEI_RPC_MAINNET=https://rpc.sei-apis.com
SEI_RPC_TESTNET=https://rpc-testnet.sei-apis.com
SEI_RPC_ARCHIVE=https://rpc-archive.sei-apis.com

# SEI Blockchain REST Endpoints
SEI_REST_MAINNET=https://rest.sei-apis.com
SEI_REST_TESTNET=https://rest-testnet.sei-apis.com

# SEI Blockchain WebSocket Endpoints
SEI_WS_MAINNET=wss://ws.sei-apis.com
SEI_WS_TESTNET=wss://ws-testnet.sei-apis.com

# SEI API Authentication
SEI_API_KEY=your-sei-api-key-here

# Frontend Environment Variables (for Vite)
VITE_SEI_RPC_MAINNET=https://rpc.sei-apis.com
VITE_SEI_RPC_TESTNET=https://rpc-testnet.sei-apis.com
VITE_SEI_REST_MAINNET=https://rest.sei-apis.com
VITE_SEI_REST_TESTNET=https://rest-testnet.sei-apis.com
VITE_SEI_WS_MAINNET=wss://ws.sei-apis.com
VITE_SEI_WS_TESTNET=wss://ws-testnet.sei-apis.com
VITE_SEI_API_KEY=your-sei-api-key-here

# Vite Frontend Configuration
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_PRIVY_APP_ID=your-privy-app-id
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id
VITE_ORCHESTRATOR_API=http://localhost:3000/api
VITE_ORCHESTRATOR_WS=ws://localhost:3000

# ElevenLabs Voice Configuration (Frontend)
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key
VITE_ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
VITE_VOICE_ENABLED=true
VITE_VOICE_STABILITY=0.5
VITE_VOICE_SIMILARITY_BOOST=0.8
VITE_VOICE_STYLE=0.0
VITE_VOICE_USE_SPEAKER_BOOST=false

# Security & Authentication
SESSION_SECRET=your-session-secret-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Privy Authentication
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# Upstash Redis (for rate limiting and session storage)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# AI Services (Server-side only)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ElevenLabs Voice Synthesis (Server-side only)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Other Third-party Services
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here-change-in-production

# MCP Server URLs (Model Context Protocol)
MCP_HIVE_URL=https://hive-intelligence-mcp-production.up.railway.app
MCP_SEI_URL=https://sei-blockchain-mcp-production.up.railway.app
MCP_PORTFOLIO_URL=https://portfolio-manager-mcp-production.up.railway.app

# MCP Server API Keys (if required)
MCP_HIVE_API_KEY=your-hive-api-key
MCP_SEI_API_KEY=your-sei-api-key
MCP_PORTFOLIO_API_KEY=your-portfolio-api-key

# MCP Feature Flags
MCP_ENABLED=true
MCP_HIVE_ENABLED=true
MCP_SEI_ENABLED=true
MCP_PORTFOLIO_ENABLED=true

# Additional API Configuration
API_TIMEOUT=30000
API_RETRY_ATTEMPTS=3
API_RATE_LIMIT_PER_MINUTE=60

# Vercel Deployment Configuration
# Note: In production, these environment variables should be set in Vercel Dashboard
# - VERCEL_URL is automatically provided by Vercel
# - For production domains, update ALLOWED_ORIGINS and NEXTAUTH_URL accordingly
# - All sensitive keys should use Vercel's encrypted environment variables

# Production Deployment Notes:
# 1. API Routes: Legacy API routes (/api/**) are served as Vercel Functions
# 2. App Router: New API routes (/app/api/**) use Next.js App Router
# 3. CORS: Configure ALLOWED_ORIGINS for your production domains
# 4. MCP Servers: Ensure MCP_*_URL variables point to production endpoints
# 5. API Keys: All keys must be set as encrypted environment variables in Vercel