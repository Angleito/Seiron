# SEI Blockchain RPC Endpoints
SEI_RPC_MAINNET=https://rpc.sei-apis.com
SEI_RPC_TESTNET=https://rpc-testnet.sei-apis.com
SEI_RPC_ARCHIVE=https://rpc-archive.sei-apis.com

# SEI Blockchain REST Endpoints
SEI_REST_MAINNET=https://rest.sei-apis.com
SEI_REST_TESTNET=https://rest-testnet.sei-apis.com

# SEI Blockchain WebSocket Endpoints
SEI_WS_MAINNET=wss://ws.sei-apis.com
SEI_WS_TESTNET=wss://ws-testnet.sei-apis.com

# SEI API Authentication
SEI_API_KEY=your-sei-api-key-here

# Frontend Environment Variables (for Vite)
VITE_SEI_RPC_MAINNET=https://rpc.sei-apis.com
VITE_SEI_RPC_TESTNET=https://rpc-testnet.sei-apis.com
VITE_SEI_REST_MAINNET=https://rest.sei-apis.com
VITE_SEI_REST_TESTNET=https://rest-testnet.sei-apis.com
VITE_SEI_WS_MAINNET=wss://ws.sei-apis.com
VITE_SEI_WS_TESTNET=wss://ws-testnet.sei-apis.com
VITE_SEI_API_KEY=your-sei-api-key-here

# Security & Authentication
SESSION_SECRET=your-session-secret-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Privy Authentication
PRIVY_APP_ID=your-privy-app-id
PRIVY_APP_SECRET=your-privy-app-secret

# Upstash Redis (for rate limiting and session storage)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# AI Services (Server-side only)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# ElevenLabs Voice Synthesis (Server-side only)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_DEFAULT_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Other Third-party Services
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key