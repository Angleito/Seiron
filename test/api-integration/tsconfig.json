{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowJs": true,
    "noEmit": true,
    "types": ["jest", "node"],
    "typeRoots": ["../../node_modules/@types", "./types"]
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "jest.setup.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage"
  ]
}