{
  "name": "api-integration-tests",
  "version": "1.0.0",
  "description": "API Integration Tests for Seiron",
  "type": "module",
  "scripts": {
    "test": "ts-node run-tests.ts",
    "test:health": "jest health-check.test.ts --verbose",
    "test:chat": "jest chat-endpoint.test.ts --verbose",
    "test:mcp": "jest mcp-connectivity.test.ts --verbose",
    "test:auth": "jest auth-middleware.test.ts --verbose",
    "test:streaming": "jest streaming-response.test.ts --verbose",
    "test:performance": "jest performance-benchmark.test.ts --verbose",
    "test:env": "jest env-validation.test.ts --verbose",
    "test:all": "jest . --verbose --testTimeout=30000",
    "test:watch": "jest . --watch",
    "test:coverage": "jest . --coverage",
    "test:ci": "jest . --ci --coverage --maxWorkers=2"
  },
  "dependencies": {
    "@jest/globals": "^29.7.0",
    "@types/eventsource": "^1.1.15",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "axios": "^1.6.2",
    "chalk": "^5.3.0",
    "dotenv": "^16.3.1",
    "eventsource": "^2.0.2",
    "jest": "^29.7.0",
    "jsonwebtoken": "^9.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "uuid": "^9.0.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "."
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "collectCoverageFrom": [
      "**/*.ts",
      "!**/*.d.ts",
      "!**/node_modules/**",
      "!**/run-tests.ts"
    ],
    "coverageDirectory": "../../coverage/api-integration",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "testTimeout": 30000,
    "verbose": true
  }
}