FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install dependencies
RUN npm ci --only=production

# Copy source files
COPY base-server.ts ./
COPY enhanced-base-server.ts ./
COPY hive-intelligence/server-v2.ts ./hive-intelligence/

# Build TypeScript
RUN npm install -g typescript
RUN tsc

# Set environment variables
ENV NODE_ENV=production
ENV MCP_LOG_LEVEL=info

# Expose stdio for MCP communication
EXPOSE 8765

# Run the server
CMD ["node", "dist/hive-intelligence/server-v2.js"]